# Railway MySQL. En Railway usa referencias al servicio MySQL.
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# Genera un valor aleatorio de 64 caracteres o más.
JWT_SECRET=
JWT_ISSUER=FuelTrack.Api
JWT_AUDIENCE=FuelTrack.Web
JWT_EXPIRATION_MINUTES=120

# URL exacta de Cloudflare Pages. Se permiten varias separadas por comas.
ALLOWED_ORIGINS=
ASPNETCORE_ENVIRONMENT=Production
ENABLE_SWAGGER=false
